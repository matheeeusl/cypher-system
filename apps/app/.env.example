# URL of the graphql-api service's GraphQL endpoint. This is read client-side
# (NEXT_PUBLIC_ prefix), since the wizard queries it directly from the
# browser. Defaults to http://localhost:4000/graphql if unset — see
# lib/graphql/client.ts.
NEXT_PUBLIC_GRAPHQL_API_URL=http://localhost:4000/graphql

# Base URL of the rules reference (apps/docs), used for "View in the reference"
# links. Defaults to https://csrd.app if unset — see lib/docs-links.ts.
# Local docs dev server: http://localhost:4321
NEXT_PUBLIC_DOCS_URL=https://csrd.app

# Better Auth (see lib/auth.ts). Generate the secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client — Google Cloud Console > APIs & Services > Credentials.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres (Neon) — use the pooled connection string.
DATABASE_URL=

# Resend (password reset + email verification). EMAIL_FROM must use a domain
# verified in Resend; a bare address is wrapped as "Cypher System <address>".
RESEND_API_KEY=
EMAIL_FROM=
