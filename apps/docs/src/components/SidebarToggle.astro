---
// Header button that collapses/expands the docs sidebar on desktop. The layout
// change itself is pure CSS keyed on [data-sidebar-collapsed] on <html> (see
// globals.css); this component only flips that attribute and remembers it.
// Below 50rem the sidebar is Starlight's own hamburger drawer, so the button
// is hidden there rather than competing with it.
import { getPageContext } from '../lib/page-context';

const locale = getPageContext(Astro.url.pathname)?.locale ?? 'en';
const label = locale === 'pt-br' ? 'Alternar menu lateral' : 'Toggle sidebar';
---

<button
	type="button"
	data-sidebar-toggle
	aria-controls="starlight__sidebar"
	aria-expanded="true"
	aria-label={label}
	title={label}
	class="hidden cursor-pointer items-center rounded border border-border bg-panel p-1.5 text-text-muted hover:text-text min-[50rem]:flex"
>
	<svg
		width="16"
		height="16"
		viewBox="0 0 16 16"
		fill="none"
		stroke="currentColor"
		stroke-width="1.5"
		aria-hidden="true"
	>
		<rect x="1.75" y="2.75" width="12.5" height="10.5" rx="1.5"></rect>
		<!-- The left "pane": filled while the sidebar is open, hollow once collapsed. -->
		<rect class="pane" x="1.75" y="2.75" width="4.5" height="10.5" rx="1.5" fill="currentColor"></rect>
	</svg>
</button>

<style>
	:global(html[data-sidebar-collapsed]) .pane {
		fill: none;
	}
</style>

<script>
	// Same key as the inline <head> script in astro.config.mjs, which applies the
	// saved state before first paint; keep the two in sync.
	const STORAGE_KEY = 'cypher-sidebar-collapsed';
	const root = document.documentElement;
	const button = document.querySelector<HTMLButtonElement>('[data-sidebar-toggle]');

	function syncExpanded() {
		button?.setAttribute('aria-expanded', String(!root.hasAttribute('data-sidebar-collapsed')));
	}

	syncExpanded();

	button?.addEventListener('click', () => {
		const collapsed = root.toggleAttribute('data-sidebar-collapsed');
		try {
			localStorage.setItem(STORAGE_KEY, collapsed ? '1' : '0');
		} catch {
			// Storage can be blocked (private mode); the toggle still works, it just won't persist.
		}
		syncExpanded();
	});
</script>
