---
// The one place the design system's three families are loaded from. Rendered
// in two heads: the standalone homepage's own <head> (src/pages/[locale]/
// index.astro) and the Starlight shell's, via src/components/Head.astro.
// Declaring `--font-*` in @cypher/ui only *names* the families; without this
// nothing downloads them and the browser silently falls back to system-ui.
//
// Weights are the ones the UI actually uses (Space Grotesk 500/600/700
// headings, Inter 400/500/600 body, IBM Plex Mono 400/500/600 chrome). Inter
// and Plex Mono also ask for their real 400 italic — taglines and the "not
// transcribed" notes are italic, and without it the browser fakes a slant.
const href =
	'https://fonts.googleapis.com/css2' +
	'?family=Space+Grotesk:wght@500;600;700' +
	'&family=Inter:ital,wght@0,400;0,500;0,600;1,400' +
	'&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400' +
	'&display=swap';
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={href} />
