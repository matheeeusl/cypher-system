---
// Breadcrumb trail rendered *outside* the content box, above it (mounted by
// src/components/TwoColumnContent.astro). Derived from the URL — see
// src/lib/page-context.ts — so no page has to pass anything in. Width and
// centring are set in src/styles/globals.css alongside the box itself, so the
// trail's left edge always lines up with the box's.
import { HOME_LABEL, getPageContext } from '../lib/page-context';

const ctx = getPageContext(Astro.url.pathname);
const title = Astro.locals.starlightRoute.entry.data.title;

// The same trail as schema.org BreadcrumbList JSON-LD, which search engines can
// show in place of the raw URL. Every level but the last needs a URL, so a
// section without its own index page ("Rules") is left out here even though
// the visible trail shows it as text. `<` is escaped so a title can never close
// the <script> early.
const jsonLd =
	ctx &&
	JSON.stringify({
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ name: HOME_LABEL[ctx.locale], item: new URL(`/${ctx.locale}/`, Astro.site).href },
			...(ctx.section && ctx.isNested && ctx.section.hasIndex
				? [
						{
							name: ctx.section.crumb[ctx.locale],
							item: new URL(`/${ctx.locale}/${ctx.segment}/`, Astro.site).href,
						},
					]
				: []),
			{ name: title, item: new URL(Astro.url.pathname, Astro.site).href },
		].map((crumb, i) => ({ '@type': 'ListItem', position: i + 1, ...crumb })),
	}).replace(/</g, '\\u003c');
---

{
	ctx && (
		<nav class="breadcrumbs" aria-label={ctx.locale === 'pt-br' ? 'Trilha de navegação' : 'Breadcrumb'}>
			<ol class="flex flex-wrap items-center font-mono text-xs text-text-muted">
				<li>
					<a href={`/${ctx.locale}/`} class="text-accent no-underline hover:text-warning">
						{HOME_LABEL[ctx.locale]}
					</a>
				</li>
				{/* Linked when the section has its own index page (Section.hasIndex —
				    see src/lib/page-context.ts) to browse from; plain text otherwise
				    (e.g. "Rules", which has no single landing page of its own). */}
				{ctx.section && ctx.isNested && (
					<li>
						<span class="opacity-50" aria-hidden="true">
							&nbsp;/&nbsp;
						</span>
						{ctx.section.hasIndex ? (
							<a href={`/${ctx.locale}/${ctx.segment}/`} class="text-accent no-underline hover:text-warning">
								{ctx.section.crumb[ctx.locale]}
							</a>
						) : (
							ctx.section.crumb[ctx.locale]
						)}
					</li>
				)}
				<li aria-current="page">
					<span class="opacity-50" aria-hidden="true">
						&nbsp;/&nbsp;
					</span>
					<span class="text-text">{title}</span>
				</li>
			</ol>
			<script type="application/ld+json" set:html={jsonLd} />
		</nav>
	)
}
