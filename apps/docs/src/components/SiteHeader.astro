---
// Shared header bar for every page on the site. Used two ways:
// - Standalone pages (currently just the homepage) import this directly,
//   since they bypass Starlight's render pipeline entirely.
// - Starlight-shell pages get it via Header.astro, wired as Starlight's
//   `components.Header` override in astro.config.mjs (Starlight-shell pages
//   never import this file directly).
// Search is the one deliberate difference between the two: Starlight's own
// <Search> only works inside Starlight's pipeline, so it's passed in as a
// named slot by whichever caller has access to it, rather than imported
// here — the homepage passes none. The `leading` slot (before the brand) works
// the same way, for the sidebar toggle: only Starlight-shell pages have a
// sidebar to toggle, so only Header.astro fills it.
import { BRAND_PREFIX } from '@cypher/ui/brand';
import { appLinks } from '../lib/app-links';
import { URL_LOCALES, type UrlLocale } from '../lib/locale';

interface Props {
	// Optional: every locale-prefixed route passes its own locale so the
	// EN/PT-BR toggle can highlight the current one and swap the path's
	// first segment. The one page with no locale of its own — 404.astro,
	// which is Astro's global fallback for any unmatched route and can't
	// know which locale the visitor was in — omits it instead of guessing;
	// that hides the toggle entirely (see below) rather than rendering a
	// pair of buttons neither of which is actually "current".
	locale?: UrlLocale;
}

const { locale } = Astro.props;

// Every locale-prefixed route on this site follows the same pattern (see
// this package's CLAUDE.md's i18n section), so the equivalent page in the
// other locale is always just a first-path-segment swap — this holds for
// the homepage root and any nested Rules/entity page alike, so it works
// from both the Starlight-shell Header override and the standalone
// homepage without depending on Starlight's own routing context.
const currentPath = Astro.url.pathname;

// 404.astro has no locale of its own, so the sign-in link falls back to English.
const signInHref = appLinks.signIn(locale ?? 'en');
const signInLabel = locale === 'pt-br' ? 'Entrar' : 'Sign in';

// Brand menu (the CYPHER:// prefix). Same fallback as above for the locale-less 404.
// The button's accessible name is "CYPHER:// Main menu", not the label alone:
// it has to contain the visible text, or someone using voice control who
// says "click CYPHER" gets no match.
const menuLocale = locale ?? 'en';
const menu = {
	label: menuLocale === 'pt-br' ? 'Menu principal' : 'Main menu',
	items: [
		{
			label: menuLocale === 'pt-br' ? 'Primeiros Passos' : 'Getting Started',
			href: `/${menuLocale}/rules/introduction/`,
			external: false,
		},
		{ label: 'Wizard', href: appLinks.newCharacter(menuLocale), external: true },
	],
};
const localeHref = (target: UrlLocale) => currentPath.replace(/^\/(en|pt-br)\//, `/${target}/`);
---

{
	/* On Starlight-shell pages, this renders inside Starlight's own <header>
	   element (PageFrame.astro), which reserves its own padding
	   (--sl-nav-pad-x/y) and background (--sl-color-bg-nav) around the
	   slotted content — without canceling those out, this bar floats inside
	   that unstyled frame instead of filling it edge-to-edge, showing a
	   visible strip of Starlight's default nav background around it. The
	   negative margin cancels exactly that padding using the SAME live
	   variables (so it tracks Starlight's own responsive breakpoints
	   automatically); min-height fills the reserved nav height. On the
	   standalone homepage neither variable exists, so both fall back to
	   their explicit 0/auto defaults — a no-op, identical to before. */
}
<div
	class="flex h-full min-h-(--sl-nav-height,auto) items-center justify-between gap-4 border-b border-border bg-panel px-4 py-3.5 sm:px-7"
	style="margin: calc(-1 * var(--sl-nav-pad-y, 0px)) calc(-1 * var(--sl-nav-pad-x, 0px));"
>
	<div class="flex items-center gap-3">
		<slot name="leading" />
		<span class="flex items-center gap-2.5">
			<span class="h-2 w-2 rounded-full bg-accent shadow-[0_0_6px_var(--color-accent)]"></span>
			<span class="relative font-mono text-[13px] tracking-[0.06em] text-text-muted">
				<button
					id="brand-menu-button"
					type="button"
					aria-label={`${BRAND_PREFIX} ${menu.label}`}
					aria-haspopup="menu"
					aria-expanded="false"
					class="brand-menu-button cursor-pointer text-inherit hover:text-accent"
				>
					{BRAND_PREFIX}
				</button>
				<a href={locale ? `/${locale}/` : '/'} class="inline-block py-1 text-inherit no-underline hover:text-accent"
					>REFERENCE</a
				>
				<div
					id="brand-menu"
					role="menu"
					hidden
					class="absolute top-full left-0 z-10 mt-3 min-w-44 overflow-hidden rounded border border-border bg-panel py-1 tracking-normal shadow-lg"
				>
					{
						menu.items.map((item) => (
							<a
								role="menuitem"
								href={item.href}
								class="block px-3.5 py-2 font-mono text-[12px] whitespace-nowrap text-text no-underline hover:bg-accent-soft hover:text-accent"
							>
								{item.label}
								{item.external ? ' ↗' : ''}
							</a>
						))
					}
				</div>
			</span>
		</span>
	</div>

	<div class="mx-2 max-w-[140px] flex-1 sm:mx-4 sm:max-w-[420px]"><slot name="search" /></div>

	<div class="flex items-center gap-2">
		<div class="relative sm:hidden">
			<button
				id="mobile-nav-toggle"
				type="button"
				aria-label={menuLocale === 'pt-br' ? 'Abrir menu' : 'Open menu'}
				aria-haspopup="menu"
				aria-expanded="false"
				aria-controls="mobile-nav-menu"
				class="flex cursor-pointer items-center rounded border border-border bg-panel px-2.5 py-1.5 text-text-muted"
			>
				☰
			</button>
			<div
				id="mobile-nav-menu"
				role="menu"
				hidden
				class="absolute top-full right-0 z-10 mt-2 flex min-w-40 flex-col gap-2 rounded border border-border bg-panel p-2 shadow-lg"
			>
				{
					locale && (
						<div class="flex overflow-hidden rounded border border-border">
							{URL_LOCALES.map((code, i) => (
								<a
									href={localeHref(code)}
									aria-current={locale === code ? 'page' : undefined}
									class:list={[
										'flex-1 px-2.5 py-1.5 text-center font-mono text-[11px]',
										i > 0 && 'border-l border-border',
										locale === code ? 'bg-accent-soft text-accent' : 'text-text-muted',
									]}
								>
									{code === 'en' ? 'EN' : 'PT-BR'}
								</a>
							))}
						</div>
					)
				}
				<a
					href={signInHref}
					class="rounded border border-accent bg-accent-soft px-2.5 py-1.5 text-center font-mono text-[11px] text-accent no-underline"
				>
					{signInLabel}
				</a>
			</div>
		</div>
		<div class="hidden items-center gap-2 sm:flex">
			{
				locale && (
					<div class="flex overflow-hidden rounded border border-border">
						{URL_LOCALES.map((code, i) => (
							<a
								href={localeHref(code)}
								aria-current={locale === code ? 'page' : undefined}
								class:list={[
									'px-2.5 py-1.5 font-mono text-[11px]',
									i > 0 && 'border-l border-border',
									locale === code ? 'bg-accent-soft text-accent' : 'text-text-muted',
								]}
							>
								{code === 'en' ? 'EN' : 'PT-BR'}
							</a>
						))}
					</div>
				)
			}
			<a
				href={signInHref}
				class="rounded border border-accent bg-accent-soft px-2.5 py-1.5 font-mono text-[11px] text-accent no-underline"
			>
				{signInLabel}
			</a>
		</div>
		<button
			id="mode-toggle"
			type="button"
			data-locale={locale ?? 'en'}
			class="mode-toggle flex cursor-pointer items-center gap-1.5 rounded border border-border bg-panel px-2.5 py-1.5 text-text-muted"
		>
			<span id="mode-label"></span>
		</button>
	</div>
</div>

<style>
	/* Starlight's reset.css sets `button { font: inherit }` inside its own
	   `starlight.reset` CSS layer, which — being layered the same as Tailwind's
	   own utility classes — can outrank a plain `font-mono text-[11px]` on this
	   button depending on layer order, making it inherit the ambient body font
	   (Inter, 16px) instead. Only shows up on Starlight-shell pages, since the
	   standalone homepage never loads that reset at all. A scoped Astro <style>
	   compiles unlayered, so it always wins — same fix BackButton.astro already
	   uses for its own button, for the same reason. */
	/* Same Starlight `button { font: inherit }` reset issue as .mode-toggle below:
	   keeps the prefix looking like the plain brand text it replaces. */
	/* The vertical padding (and the REFERENCE link's py-1 beside it) lifts both
	   to ~27px tall: two 20px-high targets side by side failed the 24px
	   minimum touch-target size. */
	.brand-menu-button {
		font: inherit;
		letter-spacing: inherit;
		padding: 0.25rem 0;
		border: 0;
		background: none;
	}
	.mode-toggle {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		/* Same reset also makes this button inherit body's line-height, which
		   Starlight's own line-height (1.75, vs. the homepage's plain 1.5)
		   otherwise makes a couple of pixels taller than its EN/PT-BR neighbour
		   on Starlight-shell pages. */
		line-height: 1.5;
	}
</style>

<script is:inline>
	{
		/* Inlined to avoid a flash of the wrong theme — mirrors Starlight's own ThemeProvider script.
		   Harmless to re-run on Starlight-shell pages too: Starlight's own <ThemeProvider/> already set
		   the same dataset attribute from the same storage key, so this just re-confirms the same value. */
		const stored = localStorage.getItem('starlight-theme');
		const theme =
			stored === 'light' || stored === 'dark'
				? stored
				: window.matchMedia('(prefers-color-scheme: light)').matches
					? 'light'
					: 'dark';
		document.documentElement.dataset.theme = theme;
	}
</script>
<script is:inline>
	{
		const btn = document.getElementById('mode-toggle');
		const label = document.getElementById('mode-label');
		const locale = btn.dataset.locale;

		const darkLabel = locale === 'en' ? '● DARK' : '● ESCURO';
		const lightLabel = locale === 'en' ? '○ LIGHT' : '○ CLARO';

		function sync() {
			const theme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
			label.textContent = theme === 'dark' ? darkLabel : lightLabel;
		}
		sync();
		btn.addEventListener('click', () => {
			const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
			document.documentElement.dataset.theme = next;
			localStorage.setItem('starlight-theme', next);
			sync();
		});
	}
</script>
<script is:inline>
	{
		const button = document.getElementById('brand-menu-button');
		const menu = document.getElementById('brand-menu');

		function setOpen(open) {
			menu.hidden = !open;
			button.setAttribute('aria-expanded', String(open));
		}
		button.addEventListener('click', () => setOpen(menu.hidden));
		// Close on a click outside the menu, or on Escape (focus returns to the button).
		document.addEventListener('mousedown', (event) => {
			if (!menu.hidden && !menu.contains(event.target) && event.target !== button) setOpen(false);
		});
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape' || menu.hidden) return;
			setOpen(false);
			button.focus();
		});
	}
</script>
<script is:inline>
	{
		// Same open/close/outside-click/Escape pattern as the brand menu above,
		// for the mobile-only dropdown holding the locale toggle + sign-in link.
		const button = document.getElementById('mobile-nav-toggle');
		const menu = document.getElementById('mobile-nav-menu');

		function setOpen(open) {
			menu.hidden = !open;
			button.setAttribute('aria-expanded', String(open));
		}
		button.addEventListener('click', () => setOpen(menu.hidden));
		document.addEventListener('mousedown', (event) => {
			if (!menu.hidden && !menu.contains(event.target) && event.target !== button) setOpen(false);
		});
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape' || menu.hidden) return;
			setOpen(false);
			button.focus();
		});
	}
</script>
