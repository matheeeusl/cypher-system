---
// The design's "Reference Table Page" / "Narrative Chapter Page" table: bordered
// box, uppercase muted header row on the panel token, mono cells, hairline row
// dividers. Shared by the Equipment page and the Character Creation chapter.
//
// `not-content` on the wrapper opts every descendant out of Starlight's markdown
// styling (its table styles and its `* + *` vertical-rhythm margins), so the
// padding here is the only spacing in play.
interface Column {
	label: string;
	// key: mono accent (roll ranges) · name: sans row label · value: mono figure
	// · prose: sans running text
	kind?: 'key' | 'name' | 'value' | 'prose';
	width?: string;
}

interface Props {
	columns: Column[];
	rows: string[][];
	caption: string;
}

const { columns, rows, caption } = Astro.props;

const CELL_CLASS: Record<NonNullable<Column['kind']>, string> = {
	key: 'font-mono text-xs whitespace-nowrap text-accent',
	name: 'text-[13px] font-medium text-text',
	value: 'font-mono text-[13px] whitespace-nowrap text-text',
	prose: 'text-[13px] leading-[1.55] text-text',
};
---

<div class="not-content my-4 overflow-x-auto rounded-[5px] border border-border">
	<table class="w-full border-collapse text-left">
		<caption class="sr-only">{caption}</caption>
		<thead>
			<tr class="bg-panel">
				{
					columns.map((column) => (
						<th
							scope="col"
							class="border-b border-border px-3.5 py-2.5 font-mono text-[11px] font-medium tracking-[0.05em] whitespace-nowrap text-text-muted uppercase"
							style={column.width ? `width: ${column.width}` : undefined}
						>
							{column.label}
						</th>
					))
				}
			</tr>
		</thead>
		<tbody class="[&_tr:last-child_td]:border-b-0">
			{
				rows.map((row) => (
					<tr>
						{row.map((cell, i) => (
							<td class={`border-b border-border px-3.5 py-2 align-top ${CELL_CLASS[columns[i]?.kind ?? 'value']}`}>
								{cell}
							</td>
						))}
					</tr>
				))
			}
		</tbody>
	</table>
</div>
