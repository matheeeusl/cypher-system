---
// Starlight `components.TwoColumnContent` override (wired in astro.config.mjs).
// Starlight renders the page's <main> inside this component, so it's the one
// override point that sits *around* <main> — that's what lets the breadcrumb
// land above the content box rather than inside it. It wraps Starlight's own
// component instead of copying it, so the column layout stays Starlight's and
// keeps up with upgrades; the only addition is the trail before the default
// slot (which holds <main>). `right-sidebar` is re-forwarded by hand because a
// wrapper doesn't pass named slots through on its own.
import Default from '@astrojs/starlight/components/TwoColumnContent.astro';
import Breadcrumbs from './Breadcrumbs.astro';
---

<Default {...Astro.props}>
	<slot name="right-sidebar" slot="right-sidebar" />
	<Breadcrumbs />
	<slot />
</Default>
