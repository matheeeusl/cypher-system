---
// Standalone landing page — deliberately outside the Starlight docs shell
// (no sidebar/TOC in the source design), so it isn't a content-collection
// page and doesn't use <StarlightPage>. It shares SiteHeader with every
// Starlight-shell page (Rules, Types, …) — real Pagefind search is the one
// deliberate difference, since Starlight's <Search> only works inside
// Starlight's own render pipeline, which this page bypasses.
//
// Because this page bypasses Starlight, it can't rely on `customCss` (that's
// wired into the Starlight integration's own render pipeline) — tokens are
// imported directly below instead.
import '../../styles/globals.css';
import SiteHeader from '@components/SiteHeader.astro';
import FontLinks from '@components/FontLinks.astro';
import SiteFooter from '@components/SiteFooter.astro';
import { appLinks } from '@lib/app-links';
import { URL_LOCALES, type UrlLocale } from '@lib/locale';

export function getStaticPaths() {
	return URL_LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: UrlLocale };
const htmlLang = locale === 'pt-br' ? 'pt-BR' : 'en';

const CHROME = {
	en: {
		eyebrow: 'Reference',
		title: 'Cypher System Reference',
		subtitle:
			'A clean, searchable reference for running and playing the Cypher System — rules, character options, and equipment in one place.',
		searchPlaceholder: 'Search the reference…',
	},
	'pt-br': {
		eyebrow: 'Referência',
		title: 'Referência do Cypher System',
		subtitle:
			'Uma referência limpa e pesquisável para dirigir e jogar o Cypher System — regras, opções de personagem e equipamentos em um só lugar.',
		searchPlaceholder: 'Pesquisar na referência…',
	},
} as const;

// Hrefs point at each category's route. All of these resolve now that
// Glossary (src/content/docs/<locale>/glossary.md) has landed.
const SECTIONS = {
	en: [
		{ title: 'Getting Started', desc: 'New to the system? Start here.', href: '/en/rules/introduction/' },
		{ title: 'Character Creation', desc: 'Build your character in the wizard.', href: appLinks.newCharacter('en'), external: true },
		{ title: 'Core Mechanics', desc: 'Task resolution, Effort, and Edge.', href: '/en/rules/core-mechanics/' },
		{ title: 'Combat', desc: 'Initiative, damage, and recovery.', href: '/en/rules/combat/' },
		{ title: 'Equipment', desc: 'Weapons, armor, and cyphers.', href: '/en/equipment/' },
		{ title: 'Character Reference', desc: 'Types, descriptors, and foci.', href: '/en/types/' },
	],
	'pt-br': [
		{ title: 'Primeiros Passos', desc: 'Novo no sistema? Comece aqui.', href: '/pt-br/rules/introduction/' },
		{ title: 'Criação de Personagem', desc: 'Monte seu personagem no assistente.', href: appLinks.newCharacter('pt-br'), external: true },
		{
			title: 'Mecânicas Principais',
			desc: 'Resolução de tarefas, Esforço e Margem.',
			href: '/pt-br/rules/core-mechanics/',
		},
		{ title: 'Combate', desc: 'Iniciativa, dano e recuperação.', href: '/pt-br/rules/combat/' },
		{ title: 'Equipamento', desc: 'Armas, armaduras e cifras.', href: '/pt-br/equipment/' },
		{ title: 'Referência de Personagem', desc: 'Tipos, descritores e focos.', href: '/pt-br/types/' },
	],
} as const;

const chrome = CHROME[locale];
const sections = SECTIONS[locale];
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<title>{chrome.title}</title>
		<meta name="description" content={chrome.subtitle} />
		<FontLinks />
	</head>
	<body class="m-0 flex min-h-screen flex-col bg-bg font-sans text-text">
		<SiteHeader locale={locale} />

		<div class="mx-auto max-w-[820px] px-4 pt-10 pb-10 text-center sm:px-7 sm:pt-[72px]">
			<div
				class="mb-[18px] inline-flex items-center gap-2 font-mono text-xs tracking-[0.08em] text-accent uppercase"
			>
				<span class="h-[7px] w-[7px] rounded-full bg-accent"></span>{chrome.eyebrow}
			</div>
			<h1 class="m-0 mb-3.5 font-display text-[30px] font-semibold tracking-[-0.01em] sm:text-[42px]">{chrome.title}</h1>
			<p class="mx-auto mb-7 max-w-[560px] text-base leading-[1.65] text-text-muted">{chrome.subtitle}</p>
			<a
				href={`/${locale}/rules/introduction/`}
				class="mx-auto flex max-w-[440px] items-center gap-2.5 rounded-md border border-border bg-panel px-4 py-3 font-mono text-[13px] text-text-muted"
			>
				<span>⌕</span>{chrome.searchPlaceholder}
			</a>
		</div>

		<div class="mx-auto max-w-[900px] px-4 pt-3 pb-12 sm:px-7">
			<div class="grid grid-cols-1 gap-3.5 sm:grid-cols-3">
				{
					sections.map((sec) => {
						// A card that leaves the reference for the app is highlighted in the
						// same accent treatment as a primary action, with an arrow icon.
						const external = 'external' in sec && sec.external;
						return (
							<a
								href={sec.href}
								class:list={[
									'block rounded-md border p-5 text-inherit',
									external ? 'border-accent bg-accent-soft hover:border-warning' : 'border-border bg-panel',
								]}
							>
								<span class="mb-3 flex items-center justify-between">
									<span class="block h-[7px] w-[7px] rounded-full bg-accent" />
									{external && (
										<span class="h-[7px] font-mono text-sm leading-none text-accent" aria-hidden="true">
											↗
										</span>
									)}
								</span>
								<div class:list={['mb-1.5 font-display text-base font-semibold']}>
									{sec.title}
								</div>
								<div class="text-[13px] leading-[1.5] text-text-muted">{sec.desc}</div>
							</a>
						);
					})
				}
			</div>
		</div>

		<SiteFooter locale={locale} class="mt-auto px-4 sm:px-7" />
	</body>
</html>
