---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getAllFoci, getFocusConnectionTable } from '@cypher/content';
import type { Focus } from '@cypher/content';
import { URL_LOCALES, pick, type UrlLocale } from '../../../lib/locale';
import AbilityEntry from '../../../components/AbilityEntry.astro';

export function getStaticPaths() {
	const foci = getAllFoci();

	return URL_LOCALES.flatMap((locale) =>
		foci.map((focus) => ({
			params: { locale, slug: focus.id },
			props: { focus },
		})),
	);
}

interface Props {
	focus: Focus;
}

const { locale } = Astro.params as { locale: UrlLocale; slug: string };
const { focus } = Astro.props as Props;

const t = (en: string, pt: string) => (locale === 'pt-br' ? pt : en);

type TierEntryView = { kind: 'granted'; id: string } | { kind: 'choice'; count: number; options: string[][] };

// tier_abilities is keyed by tier as a string ('1'..'6'); most tiers hold a
// single entry, but e.g. collects-bounties has two entries at one tier
// (a grant and a choice together) — each entry renders as its own block
// rather than assuming one-entry-per-tier. A choice's `options` can itself
// hold a bundled pick (an array of >=2 ability ids selected together, e.g.
// Transmits Energy tier 6), so every option is normalized to an array of
// ids even when it's really just one ability. Ids are passed through
// unresolved: <AbilityEntry> looks each one up and handles ones that don't
// resolve to an Ability.
const tierEntries = Object.entries(focus.tier_abilities)
	.sort(([a], [b]) => Number(a) - Number(b))
	.map(
		([tier, entries]) =>
			[
				tier,
				entries.map(
					(entry): TierEntryView =>
						entry.kind === 'granted'
							? { kind: 'granted', id: entry.ability_id }
							: {
									kind: 'choice',
									count: entry.count,
									options: entry.options.map((option) => (Array.isArray(option) ? option : [option])),
								},
				),
			] as const,
	);

// Present on a minority of Foci (a variant rule letting the character swap
// their Type for another while keeping this Focus). Almost always a single
// ability, but the schema's `ability_ids` is an array because Spits Fire
// and Lead's source prints two abilities (Cogent Shot, Reload) granted
// together under one "Type Swap Option" heading — see that Focus's own
// data file and @cypher/content's FocusSchema comment.
const typeSwapIds = focus.type_swap_option ? focus.type_swap_option.ability_ids : null;

const additionalEquipmentText = focus.additional_equipment ? pick(focus.additional_equipment, locale) : null;

// Only a handful of Foci define their own connection_options; every other
// Focus still has a connection — it just comes from the shared d100 Focus
// Connections table instead. Rendering a fallback note (rather than hiding
// the section) keeps that the common, unremarkable case it actually is,
// not something that looks missing from this Focus's page. The note links to
// the table's own section in the Character Creation chapter (heading slugs
// come from that chapter's "Choosing a Connection" / "Escolhendo uma
// Conexão" headings, so they must stay in sync with it).
const connectionTableSize = focus.connection_options ? null : getFocusConnectionTable().length;
const connectionTableHref = `/${locale}/rules/character-creation/#${t('choosing-a-connection', 'escolhendo-uma-conexão')}`;

const hasEffectSuggestion = focus.minor_effect_suggestion !== null || focus.major_effect_suggestion !== null;
---

<StarlightPage
	frontmatter={{
		title: pick(focus.name, locale),
		description: pick(focus.description, locale),
		tableOfContents: false,
	}}
>
	<p class="mb-6 max-w-[40em] text-[15px] leading-[1.55] text-text-muted italic">{pick(focus.description, locale)}</p>

	<div class="mb-6 h-px bg-border"></div>

	<h2>{t('Tier Abilities', 'Habilidades por Tier')}</h2>
	{/* not-content on the wrapper (not the rows): opts everything inside out of Starlight's sibling-margin rules, which would otherwise pad every tier row. */}
	<div class="not-content border-t border-border">
		{
			tierEntries.map(([tier, entries]) => (
				<div class="grid grid-cols-[4.25rem_1fr] gap-x-4 border-b border-border py-3">
					<span class="pt-0.5 font-mono text-xs text-accent">
						{t('Tier', 'Tier')} {tier}
					</span>
					<div class="space-y-3">
						{entries.map((entry) =>
							entry.kind === 'granted' ? (
								<AbilityEntry id={entry.id} locale={locale} />
							) : (
								<div>
									<div class="mb-1.5 font-mono text-[10px] tracking-[0.06em] text-warning uppercase">
										{entry.count === 1
											? t('Choose one', 'Escolha uma')
											: t(`Choose ${entry.count} of the following`, `Escolha ${entry.count} das seguintes`)}
									</div>
									{entry.options.map((group, gi) => (
										<>
											{gi > 0 && (
												<div class="my-1.5 ml-3 font-mono text-[11px] tracking-[0.06em] text-text-muted uppercase">
													{t('or', 'ou')}
												</div>
											)}
											{/* A bundled pick (>=2 abilities chosen together) shares one left rule, with "+" between them. */}
											<div class="space-y-2 border-l-2 border-border pl-3">
												{group.map((id, pi) => (
													<>
														{pi > 0 && <div class="font-mono text-xs text-text-muted">+</div>}
														<AbilityEntry id={id} locale={locale} />
													</>
												))}
											</div>
										</>
									))}
								</div>
							),
						)}
					</div>
				</div>
			))
		}
	</div>

	{
		typeSwapIds && (
			<>
				<h2>{t('Type Swap Option', 'Opção de Troca de Tipo')}</h2>
				<div class="not-content space-y-3 border-l-2 border-border pl-3">
					{typeSwapIds.map((id) => (
						<AbilityEntry id={id} locale={locale} />
					))}
				</div>
			</>
		)
	}

	{
		additionalEquipmentText && (
			<>
				<h2>{t('Additional Equipment', 'Equipamento Adicional')}</h2>
				<p>{additionalEquipmentText}</p>
			</>
		)
	}

	<h2>{t('Connection', 'Conexão')}</h2>
	{
		focus.connection_options ? (
			<div class="not-prose">
				{focus.connection_options.map((option, i) => (
					<>
						<div class="rounded-r border-l-2 border-border bg-panel py-2.5 pr-3 pl-4">
							<p class="text-[13px] leading-[1.55] text-text">{pick(option, locale)}</p>
						</div>
						{focus.connection_options && i < focus.connection_options.length - 1 && (
							<div class="my-1.5 ml-4 font-mono text-[11px] tracking-[0.06em] text-text-muted uppercase">
								{t('or', 'ou')}
							</div>
						)}
					</>
				))}
			</div>
		) : (
			<p class="text-text-muted">
				{t('This Focus uses the shared ', 'Este Foco usa a ')}
				<a href={connectionTableHref}>{t('Focus Connections table', 'tabela compartilhada de Conexões de Foco')}</a>
				{t(
					` — roll or choose from its ${connectionTableSize} entries.`,
					` — role ou escolha entre suas ${connectionTableSize} entradas.`,
				)}
			</p>
		)
	}

	{
		hasEffectSuggestion && (
			<>
				<h2>{t('Effect Suggestions', 'Sugestões de Efeito')}</h2>
				<div class="not-prose space-y-3">
					{focus.minor_effect_suggestion && (
						<div class="rounded border border-border bg-panel px-4 py-3">
							<p class="mb-1 font-display font-semibold text-text">{t('Minor Effect', 'Efeito Menor')}</p>
							<p class="text-[13px] leading-[1.55] text-text-muted">{pick(focus.minor_effect_suggestion, locale)}</p>
						</div>
					)}
					{focus.major_effect_suggestion && (
						<div class="rounded border border-border bg-panel px-4 py-3">
							<p class="mb-1 font-display font-semibold text-text">{t('Major Effect', 'Efeito Maior')}</p>
							<p class="text-[13px] leading-[1.55] text-text-muted">{pick(focus.major_effect_suggestion, locale)}</p>
						</div>
					)}
				</div>
			</>
		)
	}
</StarlightPage>
