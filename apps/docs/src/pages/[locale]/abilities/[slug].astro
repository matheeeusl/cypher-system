---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getAllAbilities, getTypeById, getFocusById } from '@cypher/content';
import type { Ability } from '@cypher/content';
import { URL_LOCALES, pick, type UrlLocale } from '../../../lib/locale';
import { formatAbilityCost, formatActionType } from '../../../lib/ability-format';

export function getStaticPaths() {
	const abilities = getAllAbilities();

	return URL_LOCALES.flatMap((locale) =>
		abilities.map((ability) => ({
			params: { locale, slug: ability.id },
			props: { ability },
		})),
	);
}

interface Props {
	ability: Ability;
}

const { locale } = Astro.params as { locale: UrlLocale; slug: string };
const { ability } = Astro.props as Props;

const t = (en: string, pt: string) => (locale === 'pt-br' ? pt : en);

const costText = formatAbilityCost(ability.cost, locale) ?? t('None', 'Nenhum');

const actionTypeText = formatActionType(ability.action_type, locale);

// tier lives per-source, not on the Ability itself — the same named
// ability can be granted by multiple Types/Foci at different tiers (see
// @cypher/content's AbilitySchema comment on `sources`, confirmed e.g. by
// Surprise Attack: tier 1/2/3/3/4 across five different Foci). There's no
// single canonical tier to show as a page-level badge, so each source is
// listed with its own tier instead of picking one arbitrarily. Both Type
// and Focus now have entity pages, so a source links to its real page
// whenever it resolves; an unresolved id (data gap) still falls back to
// an inert pill rather than a dead link.
const sourceEntries = ability.sources.map((source) => {
	const isType = source.type === 'type';
	const resolved = isType ? getTypeById(source.id) : getFocusById(source.id);
	return {
		tier: source.tier,
		cyberware: source.cyberware ?? false,
		isType,
		href: resolved ? `/${locale}/${isType ? 'types' : 'foci'}/${source.id}/` : null,
		categoryLabel: isType ? t('Type', 'Tipo') : t('Focus', 'Foco'),
		name: resolved ? pick(resolved.name, locale) : source.id,
	};
});

const hasCyberwareSource = ability.sources.some((source) => source.cyberware);
---

<StarlightPage
	frontmatter={{
		title: pick(ability.name, locale),
		description: pick(ability.description, locale),
		tableOfContents: false,
	}}
>
	<p class="mb-6  text-[15px] leading-[1.55] text-text-muted italic">{pick(ability.description, locale)}</p>

	<div class="mb-6 h-px bg-border"></div>

	<div class="not-content mb-7 rounded border border-border bg-panel px-5 py-4 not-prose">
		<div class="flex justify-between gap-4 border-b border-border py-1.5 font-mono text-[13px] first:pt-0">
			<span class="tracking-[0.04em] text-text-muted uppercase">{t('Cost', 'Custo')}</span>
			<span class="text-right font-medium text-text">{costText}</span>
		</div>
		<div class="flex justify-between gap-4 py-1.5 font-mono text-[13px] last:pb-0">
			<span class="tracking-[0.04em] text-text-muted uppercase">{t('Action Type', 'Tipo de Ação')}</span>
			<span class="text-right font-medium text-text">{actionTypeText}</span>
		</div>
	</div>

	<h2>{t('Sources', 'Fontes')}</h2>
	<div class="flex flex-wrap gap-1.5 not-prose">
		{
			sourceEntries.map((s) =>
				s.href ? (
					<a
						href={s.href}
						class="rounded border border-border bg-panel px-2 py-1 font-mono text-xs text-accent whitespace-nowrap no-underline hover:border-accent"
					>
						<span class="opacity-50">[</span>
						{s.categoryLabel}: {s.name} — {t('Tier', 'Tier')} {s.tier}
						{s.cyberware && ' ~'}
						<span class="opacity-50">]</span>
					</a>
				) : (
					<span class="rounded border border-border bg-panel px-2 py-1 font-mono text-xs text-accent whitespace-nowrap">
						<span class="opacity-50">[</span>
						{s.categoryLabel}: {s.name} — {t('Tier', 'Tier')} {s.tier}
						{s.cyberware && ' ~'}
						<span class="opacity-50">]</span>
					</span>
				),
			)
		}
	</div>
	{
		hasCyberwareSource && (
			<p class="mt-2 font-mono text-[11px] text-text-muted">
				{t(
					'~ indicates a cyberware-derived source, per the rulebook.',
					'~ indica uma fonte derivada de cibernética, conforme o livro de regras.',
				)}
			</p>
		)
	}
</StarlightPage>
