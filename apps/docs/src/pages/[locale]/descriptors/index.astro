---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getAllDescriptors } from '@cypher/content';
import { URL_LOCALES, pick, type UrlLocale } from '@lib/locale';
import { descriptorCategories, poolSummary } from '@lib/descriptor-format';
import CharacterSentence from '@components/CharacterSentence.astro';
import EntityIndexList from '@components/EntityIndexList.astro';

// One fixed index page per locale — the category's landing page (Home /
// Descriptors), listing every Descriptor and linking to its own
// [slug].astro page. Same shape as foci/index.astro and types/index.astro.
export function getStaticPaths() {
	return URL_LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: UrlLocale };

const t = (en: string, pt: string) => (locale === 'pt-br' ? pt : en);

// Same order as the Descriptors sidebar group in astro.config.mjs: one
// section per category in the book's order, alphabetical by English name
// inside each.
const descriptors = getAllDescriptors()
	.slice()
	.sort((a, b) => a.name.en.localeCompare(b.name.en));

// The meta column is the Pool bonus: fixed bonuses ("+2 Speed"), then the
// player's choice if there is one ("2 points to divide"). Descriptors with
// neither (Mad, Mutant, …) just show no meta.
const sections = descriptorCategories(locale).map((category) => ({
	...category,
	rows: descriptors
		.filter((descriptor) => descriptor.category === category.id)
		.map((descriptor) => ({
			href: `/${locale}/descriptors/${descriptor.id}/`,
			name: pick(descriptor.name, locale),
			meta: poolSummary(descriptor, locale),
		})),
}));
---

<StarlightPage
	frontmatter={{
		title: t('Descriptors', 'Descritores'),
		description: t(
			'What a Descriptor is, and every Descriptor available for character creation.',
			'O que é um Descritor, e todos os Descritores disponíveis para a criação de personagem.',
		),
		tableOfContents: false,
	}}
>
	<CharacterSentence locale={locale} highlight="descriptor" />

	<p class="mb-6  text-[15px] leading-[1.55] text-text-muted">
		{
			t(
				"The adjective in the character sentence. A descriptor defines what your character is like — strengths, weaknesses, and sometimes species or background — through a Pool bonus, skill training, characteristics, and occasionally an inability. There are dozens of descriptors, so it's unlikely two player characters in a group will need to share one.",
				'O adjetivo da frase do personagem. Um descritor define como seu personagem é — forças, fraquezas e, às vezes, espécie ou histórico — por meio de um bônus de Reserva, treinamento em perícias, características e, ocasionalmente, uma incapacidade. Há dezenas de descritores, então é pouco provável que dois personagens do grupo precisem compartilhar o mesmo.',
			)
		}
	</p>

	<p class="mb-6  text-[15px] leading-[1.55] text-text-muted">
		{
			t(
				'The standard descriptors fit any setting. The genre groups after them fit particular kinds of settings, and some are species rather than personalities; the GM decides which ones are available in a campaign.',
				'Os descritores padrão servem para qualquer cenário. Os grupos de gênero depois deles servem para tipos específicos de cenário, e alguns são espécies em vez de personalidades; o Mestre decide quais estão disponíveis na campanha.',
			)
		}
	</p>

	<p class="mb-6 font-mono text-xs text-text-muted uppercase">
		{descriptors.length} {t('descriptors', 'descritores')}
	</p>

	{
		sections.map((section) => (
			<>
				<h2 id={section.id}>
					{section.name} <span class="text-text-muted">· {section.rows.length}</span>
				</h2>
				{section.intro && <p class="text-[13px] leading-[1.55] text-text-muted">{section.intro}</p>}
				<EntityIndexList caption={section.name} rows={section.rows} />
			</>
		))
	}
</StarlightPage>
