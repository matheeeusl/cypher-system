---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getAllDescriptors, getSkillById } from '@cypher/content';
import type { Descriptor } from '@cypher/content';
import { URL_LOCALES, pick, type UrlLocale } from '@lib/locale';

export function getStaticPaths() {
	const descriptors = getAllDescriptors();

	return URL_LOCALES.flatMap((locale) =>
		descriptors.map((descriptor) => ({
			params: { locale, slug: descriptor.id },
			props: { descriptor },
		})),
	);
}

interface Props {
	descriptor: Descriptor;
}

const { locale } = Astro.params as { locale: UrlLocale; slug: string };
const { descriptor } = Astro.props as Props;

const t = (en: string, pt: string) => (locale === 'pt-br' ? pt : en);

// English/Portuguese labels for the three stat pools a pool_bonus entry can
// target — UI chrome, not rulebook prose, so translated directly here
// rather than sourced from @cypher/content (same rationale as the Types
// page's PRICE_TIER_LABELS).
const STAT_LABELS: Record<'might' | 'speed' | 'intellect', [string, string]> = {
	might: ['Might', 'Força'],
	speed: ['Speed', 'Velocidade'],
	intellect: ['Intellect', 'Intelecto'],
};

// Usually 0 or 1 entries; Strong-Willed and Tongue-Tied grant two at once
// (see @cypher/content's DescriptorSchema comment) — rendered as one row
// per entry rather than assuming a single stat.
const poolBonusRows = descriptor.pool_bonus.map((bonus) => [
	`${t(...STAT_LABELS[bonus.stat])} ${t('Pool Bonus', 'Bônus de Reserva')}`,
	`+${bonus.amount}`,
]);

// What a "choose N skills" entry may be picked from. The rulebook restricts
// these (Calm: "nonphysical skills"; Creative: "one specific creative skill";
// Intelligent/Learned/Mad: "an area of knowledge") but the skill catalog is
// deliberately uncategorized (see @cypher/content's SkillSchema), so the
// restriction is shown as text rather than enforced. UI chrome keyed by
// Descriptor id, same rationale as the other label tables in this file.
const CHOICE_RESTRICTIONS: Record<string, [string, string]> = {
	calm: ['nonphysical skills', 'perícias não físicas'],
	creative: [
		'a creative skill (writing, coding, composing music, painting…)',
		'uma perícia criativa (escrita, programação, composição musical, pintura…)',
	],
	intelligent: ['an area of knowledge', 'uma área de conhecimento'],
	learned: ['areas of knowledge', 'áreas de conhecimento'],
	mad: ['an area of knowledge (probably weird or esoteric)', 'uma área de conhecimento (provavelmente algo estranho ou esotérico)'],
};
const choiceRestriction = CHOICE_RESTRICTIONS[descriptor.id];

// Each entry is either a specific skill (skill_id set) or "N skills of your
// choice" (choice_count set) — never both, per the schema's documented
// convention. Resolved here, once, so the template just branches on `kind`.
const skillTrainingEntries = descriptor.skill_training.map((entry) =>
	entry.skill_id
		? { kind: 'fixed' as const, id: entry.skill_id, skill: getSkillById(entry.skill_id) }
		: { kind: 'choice' as const, count: entry.choice_count ?? 0 },
);

const additionalEquipmentText = descriptor.additional_equipment
	? pick(descriptor.additional_equipment, locale)
	: null;
---

<StarlightPage
	frontmatter={{
		title: pick(descriptor.name, locale),
		description: pick(descriptor.description, locale),
		tableOfContents: false,
	}}
>
	<p class="mb-6  text-[15px] leading-[1.55] text-text-muted italic">{pick(descriptor.description, locale)}</p>

	<div class="mb-6 h-px bg-border"></div>

	{
		poolBonusRows.length > 0 && (
			<div class="not-content mb-7 rounded border border-border bg-panel px-5 py-4 not-prose">
				{poolBonusRows.map(([label, value]) => (
					<div class="flex justify-between gap-4 border-b border-border py-1.5 font-mono text-[13px] last:border-b-0 last:pb-0 first:pt-0">
						<span class="tracking-[0.04em] text-text-muted uppercase">{label}</span>
						<span class="text-right font-medium text-text">{value}</span>
					</div>
				))}
			</div>
		)
	}

	{
		descriptor.characteristics.length > 0 && (
			<>
				<h2>{t('Characteristics', 'Características')}</h2>
				<div class="not-prose">
					{descriptor.characteristics.map((c) => (
						<div class="mb-3 rounded border border-border bg-panel px-4 py-3">
							<p class="mb-1 font-display font-semibold text-text">{pick(c.name, locale)}</p>
							<p class="text-[13px] leading-[1.55] text-text-muted">{pick(c.description, locale)}</p>
						</div>
					))}
				</div>
			</>
		)
	}

	{
		skillTrainingEntries.length > 0 && (
			<>
				<h2>{t('Skill Training', 'Treinamento de Perícias')}</h2>
				<div class="not-content">
					<div class="flex flex-wrap gap-1.5 not-prose">
						{/* Fixed entries link to their Skill page. Every skill id a
						    Descriptor references is guaranteed to resolve (a loader test
						    fails otherwise), but the inert raw-id pill is kept as a
						    fallback so a bad id can never point at a page getStaticPaths
						    didn't generate. Choice entries ("N skills of your choice")
						    have no skill to link to, so they render as a plain muted pill
						    instead of a bracketed link. */}
						{skillTrainingEntries.map((entry) =>
							entry.kind === 'fixed' ? (
								entry.skill ? (
									<a
										href={`/${locale}/skills/${entry.id}/`}
										class="rounded border border-border bg-panel px-2 py-1 font-mono text-xs text-accent whitespace-nowrap no-underline hover:border-accent"
									>
										<span class="opacity-50">[</span>
										{pick(entry.skill.name, locale)}
										<span class="opacity-50">]</span>
									</a>
								) : (
									<span class="rounded border border-border bg-panel px-2 py-1 font-mono text-xs text-accent whitespace-nowrap">
										<span class="opacity-50">[</span>
										{entry.id}
										<span class="opacity-50">]</span>
									</span>
								)
							) : (
								<span class="rounded border border-border bg-panel px-2 py-1 font-mono text-xs text-text-muted whitespace-nowrap">
									{t(`Choose ${entry.count}`, `Escolha ${entry.count}`)}
									{choiceRestriction && ` · ${t(...choiceRestriction)}`}
								</span>
							),
						)}
					</div>
				</div>
			</>
		)
	}

	{
		descriptor.inabilities.length > 0 && (
			<>
				<h2>{t('Inabilities', 'Incapacidades')}</h2>
				{descriptor.inabilities.map((inability) => <p>{pick(inability, locale)}</p>)}
			</>
		)
	}

	{
		additionalEquipmentText && (
			<>
				<h2>{t('Additional Equipment', 'Equipamento Adicional')}</h2>
				<p>{additionalEquipmentText}</p>
			</>
		)
	}

	<h2>{t('Initial Link to the Starting Adventure', 'Vínculo Inicial com a Aventura Inicial')}</h2>
	<div class="not-prose">
		{descriptor.connection_options.map((option, i) => (
			<>
				<div class="rounded-r border-l-2 border-border bg-panel py-2.5 pr-3 pl-4">
					<p class="text-[13px] leading-[1.55] text-text">{pick(option, locale)}</p>
				</div>
				{i < descriptor.connection_options.length - 1 && (
					<div class="my-1.5 ml-4 font-mono text-[11px] tracking-[0.06em] text-text-muted uppercase">{t('or', 'ou')}</div>
				)}
			</>
		))}
	</div>
</StarlightPage>
