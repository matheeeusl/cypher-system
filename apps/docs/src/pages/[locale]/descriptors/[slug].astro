---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getAllDescriptors, getMutantMutationTable, getSkillById } from '@cypher/content';
import type { Descriptor } from '@cypher/content';
import { URL_LOCALES, pick, type UrlLocale } from '@lib/locale';
import { categoryName, poolChoiceText, signedAmount, statLabel } from '@lib/descriptor-format';
import ReferenceTable from '@components/ReferenceTable.astro';
import SkillTrainingPill from '@components/SkillTrainingPill.astro';

export function getStaticPaths() {
	const descriptors = getAllDescriptors();

	return URL_LOCALES.flatMap((locale) =>
		descriptors.map((descriptor) => ({
			params: { locale, slug: descriptor.id },
			props: { descriptor },
		})),
	);
}

interface Props {
	descriptor: Descriptor;
}

const { locale } = Astro.params as { locale: UrlLocale; slug: string };
const { descriptor } = Astro.props as Props;

const t = (en: string, pt: string) => (locale === 'pt-br' ? pt : en);

// Genre descriptors get a badge linking to their section of the index;
// Standard is the default and gets none.
const category =
	descriptor.category === 'standard'
		? null
		: { id: descriptor.category, name: categoryName(descriptor.category, locale) };

// One row per fixed bonus (Tongue-Tied, Clumsy and a few others have two or
// three, some negative), then one row for the player's choice if the
// Descriptor has one (Hideous's 4 points to divide, Sylph's +2 Intellect or
// +2 Speed).
const poolBonusRows = [
	...descriptor.pool_bonus.map((bonus) => [
		t(`${statLabel(bonus.stat, locale)} Pool Bonus`, `Bônus de Reserva de ${statLabel(bonus.stat, locale)}`),
		signedAmount(bonus.amount),
	]),
	...(descriptor.pool_bonus_choice
		? [[t('Pool Bonus (your choice)', 'Bônus de Reserva (à sua escolha)'), poolChoiceText(descriptor.pool_bonus_choice, locale)]]
		: []),
];

// Mutant is the only Descriptor whose characteristics roll on tables; they
// live in their own reference file (see @cypher/content's mutant-mutations
// schema), so the page fetches them by id.
const mutationTables = descriptor.id === 'mutant' ? getMutantMutationTable() : [];

// What a "choose N skills" entry may be picked from. The rulebook restricts
// these (Calm: "nonphysical skills"; Creative: "one specific creative skill";
// Intelligent/Learned/Mad: "an area of knowledge") but the skill catalog is
// deliberately uncategorized (see @cypher/content's SkillSchema), so the
// restriction is shown as text rather than enforced. UI chrome keyed by
// Descriptor id, same rationale as the other label tables in this file.
const CHOICE_RESTRICTIONS: Record<string, [string, string]> = {
	calm: ['nonphysical skills', 'perícias não físicas'],
	creative: [
		'a creative skill (writing, coding, composing music, painting…)',
		'uma perícia criativa (escrita, programação, composição musical, pintura…)',
	],
	intelligent: ['an area of knowledge', 'uma área de conhecimento'],
	learned: ['areas of knowledge', 'áreas de conhecimento'],
	mad: ['an area of knowledge (probably weird or esoteric)', 'uma área de conhecimento (provavelmente algo estranho ou esotérico)'],
};
const choiceRestriction = CHOICE_RESTRICTIONS[descriptor.id];

// A level above trained that holds only somewhere, printed on the pill like
// `level: specialized` is. The Elf's woodland stealth is the one case: the
// data keeps it trained (it is, elsewhere) and the note has the condition,
// so the short label is UI chrome keyed here like CHOICE_RESTRICTIONS.
const CONDITIONAL_LEVELS: Record<string, Record<string, [string, string]>> = {
	elf: { stealth: ['specialized in woodland', 'especializado em bosques'] },
};
const conditionalLevel = (skillId: string) => {
	const label = CONDITIONAL_LEVELS[descriptor.id]?.[skillId];
	return label && t(...label);
};

// Each entry is either a specific skill (skill_id set) or "N skills of your
// choice" (choice_count set) — never both, per the schema's documented
// convention. Resolved here, once, so the template just branches on `kind`.
//
// A `note` (genre descriptors: "You are trained in tasks related to stone,
// including…", or Addicted's list of skills to pick from) is a whole
// sentence, too long for a pill. A fixed skill is just its linked pill — the
// Skill page is the reference, and the note rides along as a tooltip. Only a
// noted *choice* renders as a row below the pills, since "Choose 1" means
// nothing without saying what from (Uncanny: perception or stealth).
const skillTrainingEntries = descriptor.skill_training.map((entry) => ({
	...(entry.skill_id
		? {
				kind: 'fixed' as const,
				id: entry.skill_id,
				skill: getSkillById(entry.skill_id),
				level:
					entry.level === 'specialized'
						? t('specialized', 'especializado')
						: conditionalLevel(entry.skill_id),
			}
		: { kind: 'choice' as const, count: entry.choice_count ?? 0 }),
	note: entry.note ? pick(entry.note, locale) : null,
}));
const plainSkillEntries = skillTrainingEntries.filter((entry) => entry.kind === 'fixed' || !entry.note);
const notedSkillEntries = skillTrainingEntries.filter((entry) => entry.kind === 'choice' && entry.note);

const additionalEquipmentText = descriptor.additional_equipment
	? pick(descriptor.additional_equipment, locale)
	: null;
---

<StarlightPage
	frontmatter={{
		title: pick(descriptor.name, locale),
		description: pick(descriptor.description, locale),
		tableOfContents: false,
	}}
>
	{
		category && (
			<div class="not-content mb-4">
				<a
					href={`/${locale}/descriptors/#${category.id}`}
					class="inline-block rounded border border-accent px-2.5 py-1 font-mono text-[11px] tracking-[0.06em] text-accent uppercase no-underline hover:bg-accent-soft"
				>
					{category.name}
				</a>
			</div>
		)
	}

	<p class="mb-6  text-[15px] leading-[1.55] text-text-muted italic">{pick(descriptor.description, locale)}</p>

	<div class="mb-6 h-px bg-border"></div>

	{
		poolBonusRows.length > 0 && (
			<div class="not-content mb-7 rounded border border-border bg-panel px-5 py-4 not-prose">
				{poolBonusRows.map(([label, value]) => (
					<div class="flex justify-between gap-4 border-b border-border py-1.5 font-mono text-[13px] last:border-b-0 last:pb-0 first:pt-0">
						<span class="tracking-[0.04em] text-text-muted uppercase">{label}</span>
						<span class="text-right font-medium text-text">{value}</span>
					</div>
				))}
			</div>
		)
	}

	{
		descriptor.characteristics.length > 0 && (
			<>
				<h2>{t('Characteristics', 'Características')}</h2>
				<div class="not-prose">
					{descriptor.characteristics.map((c) => (
						<div class="mb-3 rounded border border-border bg-panel px-4 py-3">
							<p class="mb-1 font-display font-semibold text-text">{pick(c.name, locale)}</p>
							<p class="text-[13px] leading-[1.55] text-text-muted">{pick(c.description, locale)}</p>
						</div>
					))}
				</div>
			</>
		)
	}

	{
		skillTrainingEntries.length > 0 && (
			<>
				<h2>{t('Skill Training', 'Treinamento de Perícias')}</h2>
				<div class="not-content">
					{plainSkillEntries.length > 0 && (
						<div class="flex flex-wrap gap-1.5 not-prose">
							{plainSkillEntries.map((entry) => (
								<SkillTrainingPill
									entry={entry}
									locale={locale}
									restriction={choiceRestriction && t(...choiceRestriction)}
								/>
							))}
						</div>
					)}
					{notedSkillEntries.map((entry) => (
						<div class="mt-3 flex flex-col items-start gap-1.5 rounded border border-border bg-panel px-4 py-3 first:mt-0">
							<SkillTrainingPill entry={entry} locale={locale} />
							<p class="text-[13px] leading-[1.55] text-text-muted">{entry.note}</p>
						</div>
					))}
				</div>
			</>
		)
	}

	{
		mutationTables.map((table) => {
			const hasEffects = table.rows.some((row) => row.effect);
			return (
				<>
					<h2 id={`mutations-${table.id}`}>{pick(table.name, locale)}</h2>
					<p class="text-[13px] leading-[1.55] text-text-muted">{pick(table.intro, locale)}</p>
					<ReferenceTable
						caption={pick(table.name, locale)}
						columns={[
							{ label: 'd100', kind: 'key', width: '5rem' },
							{ label: t('Mutation', 'Mutação'), kind: 'name' },
							...(hasEffects ? [{ label: t('Effect', 'Efeito'), kind: 'prose' as const }] : []),
						]}
						rows={table.rows.map((row) => [
							row.range,
							pick(row.name, locale),
							...(hasEffects ? [row.effect ? pick(row.effect, locale) : '—'] : []),
						])}
					/>
				</>
			);
		})
	}

	{
		descriptor.inabilities.length > 0 && (
			<>
				<h2>{t('Inabilities', 'Incapacidades')}</h2>
				{descriptor.inabilities.map((inability) => <p>{pick(inability, locale)}</p>)}
			</>
		)
	}

	{
		additionalEquipmentText && (
			<>
				<h2>{t('Additional Equipment', 'Equipamento Adicional')}</h2>
				<p>{additionalEquipmentText}</p>
			</>
		)
	}

	{
		/* Several genre descriptors (Artificially Intelligent, Quintar, …)
		   have no Initial Links in the book, so the section is skipped. */
		descriptor.connection_options.length > 0 && (
			<>
				<h2>{t('Initial Link to the Starting Adventure', 'Vínculo Inicial com a Aventura Inicial')}</h2>
				<div class="not-prose">
					{descriptor.connection_options.map((option, i) => (
						<>
							<div class="rounded-r border-l-2 border-border bg-panel py-2.5 pr-3 pl-4">
								<p class="text-[13px] leading-[1.55] text-text">{pick(option, locale)}</p>
							</div>
							{i < descriptor.connection_options.length - 1 && (
								<div class="my-1.5 ml-4 font-mono text-[11px] tracking-[0.06em] text-text-muted uppercase">{t('or', 'ou')}</div>
							)}
						</>
					))}
				</div>
			</>
		)
	}
</StarlightPage>
