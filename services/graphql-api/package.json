    "fastify": "^5.10.0",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.21.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.19.2",
    "vitest": "^4.1.10"
  }
